[Unit]
Description=Decode CAN messages into Redis
Wants=slcan0.service redis-server.service
After=slcan0.service redis-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/lib/onboard-car-software-dockerless/services/deserializer
ExecStart=/var/lib/onboard-car-software-dockerless/services/deserializer/.venv/bin/python -u /var/lib/onboard-car-software-dockerless/services/deserializer/main.py slcan0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
